# -----------------------------------------------------------------------------
# Grifo — variáveis de ambiente
# Copie para .env.local e preencha. Nunca versione valores reais.
# Variáveis NEXT_PUBLIC_* vão para o navegador: não coloque segredos nelas.
# -----------------------------------------------------------------------------

# URL pública da aplicação (sem barra no final). Usada em e-mails e redirecionamentos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (obrigatório) ---------------------------------------------------
# Projeto local: rode `npx supabase start` e copie os valores exibidos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (sb_publishable_...) ou, em projetos antigos, a anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a service_role key. SOMENTE no servidor.
SUPABASE_SECRET_KEY=
# Login com Google: ative o provedor no painel do Supabase antes de ligar esta opção.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Inteligência artificial (opcional; sem ela os recursos de IA ficam desativados) ---
# Provedor: "anthropic" (padrão) ou "openai_compatible" (OpenAI, Maritaca, Groq, Ollama...).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo principal e modelo para tarefas leves (títulos de conversa). Padrão: claude-opus-5-5.
AI_MODEL=claude-opus-5-5
AI_MODEL_LIGHT=
# Para AI_PROVIDER=openai_compatible:
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Tempo máximo de uma chamada ao modelo, em milissegundos.
AI_REQUEST_TIMEOUT_MS=120000

# --- Segurança interna ----------------------------------------------------------
# Segredo para gerar chaves anônimas de visualização e tokens (32+ caracteres aleatórios).
APP_HASH_SECRET=
# Segredo exigido pelas rotas /api/cron/* (agendador da Vercel ou outro).
CRON_SECRET=

# --- E-mail transacional (opcional: lembretes e consentimento de responsáveis) ----
# Sem estas variáveis, lembretes por e-mail e convites a responsáveis ficam desativados.
RESEND_API_KEY=
EMAIL_FROM="Grifo <nao-responda@seudominio.com.br>"

# --- Pagamentos (opcional; o plano Pro fica indisponível até configurar) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
# Preço exibido na página de planos, em centavos (ex.: 1990 para R$ 19,90).
NEXT_PUBLIC_PRO_PRICE_CENTS=

# --- Informações legais exibidas no rodapé e nas políticas ------------------------
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_DOCUMENT=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DPO_EMAIL=
